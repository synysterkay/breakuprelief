---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { homeCopy, localePath, locales, type LocaleTag } from '../../../data/site';

export function getStaticPaths() {
  return locales.filter((locale) => locale.tag !== 'en').map((locale) => ({ params: { lang: locale.tag } }));
}

const lang = Astro.params.lang as LocaleTag;
const copy = homeCopy[lang];
const articles = (await getCollection('blog'))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---
<BaseLayout title={`${copy.blog} | Breakup Relief`} description={copy.subtitle} lang={lang} path={`/${lang}/blog/`}>
  <Header lang={lang} />
  <main class="shell section">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.blog}</h1>
    <div class="blog-grid">
      {articles.map((article) => (
        <a class="card" href={localePath(lang, `/blog/${article.data.seoSlug}/`)} style="text-decoration:none">
          <p class="eyebrow">{article.data.category}</p>
          <h3>{article.data.title}</h3>
          <p class="muted">{article.data.description}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
