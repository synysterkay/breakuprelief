---
import { locales, site, type LocaleTag } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: LocaleTag;
  path?: string;
  schema?: unknown;
}

const { title, description, lang = 'en', path = '/', schema } = Astro.props;
const canonical = new URL(path, site.domain).toString();
const dir = locales.find((locale) => locale.tag === lang)?.dir ?? 'ltr';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.domain}/appicon.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #17211e;
    --muted: #5f6f6a;
    --paper: #fbfaf6;
    --surface: #ffffff;
    --line: #dfe6df;
    --sage: #789782;
    --moss: #385b49;
    --coral: #d96f5f;
    --gold: #d6a646;
    --blue: #567a9f;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
  }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .shell { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    gap: 20px;
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; text-decoration: none; }
  .brand img { width: 36px; height: 36px; border-radius: 8px; }
  .nav-links { display: flex; gap: 16px; align-items: center; color: var(--muted); font-weight: 650; font-size: 14px; }
  .nav-links a { text-decoration: none; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 7px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: white;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }
  .button.secondary { background: white; color: var(--ink); border-color: var(--line); }
  .eyebrow {
    color: var(--moss);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0;
  }
  .hero {
    min-height: calc(100vh - 74px);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(310px, 0.95fr);
    gap: 52px;
    align-items: center;
    padding: 34px 0 58px;
  }
  h1 {
    margin: 12px 0 18px;
    font-size: clamp(42px, 7vw, 78px);
    line-height: .96;
    letter-spacing: 0;
  }
  h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.05; margin: 0 0 16px; letter-spacing: 0; }
  h3 { margin: 0 0 8px; font-size: 20px; }
  .lead { font-size: clamp(18px, 2vw, 22px); color: var(--muted); max-width: 650px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-card {
    background: #edf3ec;
    border: 1px solid #d7e3d8;
    border-radius: 8px;
    padding: 22px;
  }
  .phone {
    width: min(360px, 100%);
    margin: 0 auto;
    border-radius: 34px;
    background: #18231f;
    padding: 12px;
    box-shadow: 0 28px 70px rgba(23, 33, 30, .22);
  }
  .screen {
    min-height: 620px;
    border-radius: 26px;
    background: linear-gradient(180deg, #fffdf8 0%, #edf6ef 100%);
    padding: 22px;
    overflow: hidden;
  }
  .chat { display: grid; gap: 12px; margin-top: 26px; }
  .bubble {
    padding: 13px 14px;
    border-radius: 8px;
    background: white;
    border: 1px solid var(--line);
    color: #32443d;
  }
  .bubble.me { background: #385b49; color: white; margin-left: 38px; }
  .section { padding: 78px 0; }
  .band { background: white; border-block: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 22px;
  }
  .band .card { background: #fbfaf6; }
  .muted { color: var(--muted); }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .article {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 0 90px;
  }
  .article h1 { font-size: clamp(38px, 6vw, 64px); }
  .article p, .article li { font-size: 18px; }
  .article-cta {
    margin: 34px 0;
    padding: 22px;
    border: 1px solid #d7e3d8;
    border-radius: 8px;
    background: #edf3ec;
  }
  .footer { padding: 36px 0; color: var(--muted); border-top: 1px solid var(--line); }
  .language-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .pill {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 12px;
    text-decoration: none;
    background: white;
    font-weight: 650;
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .shell { width: min(100% - 28px, 1120px); }
    .nav { align-items: flex-start; }
    .nav-links { gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .hero { min-height: auto; grid-template-columns: 1fr; gap: 28px; padding-top: 18px; }
    .grid, .blog-grid { grid-template-columns: 1fr; }
    .screen { min-height: 520px; }
  }
</style>
